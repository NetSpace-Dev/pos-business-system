// ============================================
// POS Business Management System - Database Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH
// ============================================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("admin") // admin, staff
  roleId       Int?
  roleRef      Role?    @relation(fields: [roleId], references: [id])
  status       String   @default("active") // active, suspended
  createdAt    DateTime @default(now())

  @@map("users")
}

// ============================================
// CLIENTS
// ============================================

model Client {
  id            Int      @id @default(autoincrement())
  companyName   String
  contactPerson String
  phone         String
  email         String?
  address       String?
  notes         String?
  taxNumber     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  textLkUid     String?  // UID returned by Text.lk when contact is created

  quotations        Quotation[]
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
  supportTickets    SupportTicket[]
  projectDeadlines  ProjectDeadline[]

  @@map("clients")
}

// ============================================
// QUOTATIONS
// ============================================

model Quotation {
  id          Int      @id @default(autoincrement())
  quoteNumber String   @unique
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  issueDate   DateTime @default(now())
  validUntil  DateTime
  status      String   @default("draft") // draft, sent, accepted, rejected, converted
  subtotal    Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount Decimal  @default(0) @db.Decimal(12, 2)
  terms       String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items   QuotationItem[]
  invoice Invoice?

  @@map("quotations")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId      Int?
  item        InventoryItem? @relation(fields: [itemId], references: [id])
  description String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)

  @@map("quotation_items")
}

// ============================================
// INVOICES
// ============================================

model Invoice {
  id            Int       @id @default(autoincrement())
  invoiceNumber String    @unique
  clientId      Int
  client        Client    @relation(fields: [clientId], references: [id])
  quotationId   Int?      @unique
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  status        String    @default("draft") // draft, sent, partially_paid, paid, overdue, cancelled
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal   @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal   @default(0) @db.Decimal(12, 2)
  paymentTerms  String?
  notes         String?
  isRecurringGenerated Boolean @default(false)
  recurringInvoiceId Int?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  projectDeadlines ProjectDeadline[]

  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      Int?
  item        InventoryItem? @relation(fields: [itemId], references: [id])
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)

  @@map("invoice_items")
}

// ============================================
// RECURRING INVOICES (e.g. Hosting fees)
// ============================================

model RecurringInvoice {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        Client   @relation(fields: [clientId], references: [id])
  title         String   // e.g. "Web Hosting Fee"
  description   String?
  amount        Decimal  @db.Decimal(12, 2)
  frequency     String   // monthly, quarterly, yearly
  startDate     DateTime
  nextRunDate   DateTime
  endDate       DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  generatedInvoices Invoice[]

  @@map("recurring_invoices")
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String   // cash, bank_transfer, cheque, card
  paidDate   DateTime @default(now())
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())
  allocation PaymentAllocation?

  @@map("payments")
}

// ============================================
// INVENTORY
// ============================================

model InventoryItem {
  id           Int      @id @default(autoincrement())
  sku          String   @unique
  name         String
  category     String   // hardware, software, service
  description  String?
  dealerId     Int?
  dealer       Dealer?  @relation(fields: [dealerId], references: [id])
  stockQty     Int      @default(0) // meaningful for hardware; software/service may ignore
  reorderLevel Int      @default(5)
  unitCost     Decimal  @db.Decimal(12, 2)
  sellPrice    Decimal  @db.Decimal(12, 2)
  warrantyMonths Int?
  licenseCount Int?     // meaningful for software license count tracking
  renewalDate  DateTime? // software annual license renewal date
  isTracked    Boolean  @default(true) // false for unlimited software/service items
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@map("inventory_items")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      InventoryItem @relation(fields: [itemId], references: [id])
  type      String   // in, out, adjustment
  quantity  Int
  reason    String?  // "invoice #123", "purchase from dealer", "manual adjustment"
  createdAt DateTime @default(now())

  @@map("stock_movements")
}

// ============================================
// DEALERS
// ============================================

model Dealer {
  id          Int      @id @default(autoincrement())
  name        String
  contactPerson String?
  phone       String?
  email       String?
  address     String?
  paymentType String   @default("credit") // cash, credit
  balanceDue  Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        InventoryItem[]
  transactions DealerTransaction[]

  @@map("dealers")
}

model DealerTransaction {
  id          Int      @id @default(autoincrement())
  dealerId    Int
  dealer      Dealer   @relation(fields: [dealerId], references: [id])
  type        String   // purchase, payment
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  txnDate     DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("dealer_transactions")
}

// ============================================
// SUPPORT TICKETS (admin-logged, client-linked)
// ============================================

model SupportTicket {
  id           Int       @id @default(autoincrement())
  ticketNumber String    @unique
  clientId     Int
  client       Client    @relation(fields: [clientId], references: [id])
  problemDesc  String
  priority     String    @default("medium") // low, medium, high, urgent
  status       String    @default("open") // open, in_progress, resolved, closed
  solutionNotes String?
  handledBy    String?
  createdAt    DateTime  @default(now())
  closedAt     DateTime?
  updatedAt     DateTime @updatedAt

  updates TicketUpdate[]

  @@map("support_tickets")
}

model TicketUpdate {
  id           Int           @id @default(autoincrement())
  ticketId     Int
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  note         String
  statusChange String?
  createdAt    DateTime      @default(now())

  @@map("ticket_updates")
}

// ============================================
// PROJECT TIMELINE / DEADLINES
// ============================================

model ProjectDeadline {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  invoiceId   Int?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  description String
  deadlineDate DateTime
  status      String   @default("pending") // pending, completed, overdue
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_deadlines")
}

// ============================================
// CUSTOM ROLES & PERMISSIONS
// ============================================

model Role {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  permissionSet String   @db.Text // Store JSON representation of permissions
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]

  @@map("roles")
}

// ============================================
// SYSTEM SETTINGS
// ============================================

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedBy String?  // User email/name who updated it
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model SettingHistory {
  id        Int      @id @default(autoincrement())
  key       String
  oldValue  String?  @db.Text
  newValue  String   @db.Text
  updatedBy String?
  updatedAt DateTime @default(now())

  @@map("setting_history")
}

// ============================================
// FINANCE PAYMENT ALLOCATIONS
// ============================================

model PaymentAllocation {
  id                 Int      @id @default(autoincrement())
  paymentId          Int      @unique
  payment            Payment  @relation(fields: [paymentId], references: [id])
  grossAmount        Decimal  @db.Decimal(12, 2)
  cogsAmount         Decimal  @db.Decimal(12, 2)
  taxAmount          Decimal  @db.Decimal(12, 2)
  netAmount          Decimal  @db.Decimal(12, 2)
  reinvestPctUsed    Decimal  @db.Decimal(5, 2)
  reinvestAmount     Decimal  @db.Decimal(12, 2)
  partnerPoolAmount  Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  payouts            PartnerPayout[]

  @@map("payment_allocations")
}

// ============================================
// PARTNERS & PAYOUTS
// ============================================

model Partner {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  ownershipPct Decimal  @db.Decimal(5, 2) // e.g. 50.00
  status       String   @default("active") // active, inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  payouts      PartnerPayout[]

  @@map("partners")
}

model PartnerPayout {
  id           Int      @id @default(autoincrement())
  partnerId    Int
  partner      Partner  @relation(fields: [partnerId], references: [id])
  allocationId Int
  allocation   PaymentAllocation @relation(fields: [allocationId], references: [id])
  amount       Decimal  @db.Decimal(12, 2)
  status       String   @default("pending") // pending, paid
  paidDate     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("partner_payouts")
}

// ============================================
// REINVESTMENT FUND USAGE LOG
// ============================================

model ReinvestmentUsage {
  id         Int      @id @default(autoincrement())
  amountUsed Decimal  @db.Decimal(12, 2)
  purpose    String
  usedDate   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("reinvestment_usage")
}

// ============================================
// OPERATIONAL EXPENSES
// ============================================

model Expense {
  id          Int      @id @default(autoincrement())
  category    String   // e.g. Salaries, Rent, Utilities
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userEmail String?
  action    String   // e.g. "UPDATE_SETTINGS", "EDIT_INVOICE", "PAY_PARTNER"
  details   String   @db.Text
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

